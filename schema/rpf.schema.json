{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakuseki.github.io/recipe-process-format/schema/rpf.schema.json",
  "title": "Recipe Process Format",
  "type": "object",
  "required": ["recipe"],
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["Ingredient", "Operation", "IntermediateProduct", "Product"]},
        "name": {"type": "string"}
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string"},
        "to": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "recipe": {
      "type": "object",
      "required": ["metadata", "graph"],
      "properties": {
        "metadata": {"type": "object"},
        "graph": {
          "type": "object",
          "required": ["nodes", "edges"],
          "properties": {
            "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
            "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}